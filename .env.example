# ==========================================
# Céos System - Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local e preencha com seus dados:
# cp .env.example .env.local
# ==========================================

# Aplicação
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Céos System"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Banco de Dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ceossystem?schema=public"

# Autenticação e Segurança
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
JWT_SECRET=

# Serviço de Envio de E-mail (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contato@ceossystem.com

# Armazenamento / Upload de Certificados e Arquivos (Opcional)
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ==========================================
# Firebase Configuration
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ==========================================
# EmailJS Configuration (Página de Contato)
# ==========================================
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
