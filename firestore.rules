rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário é administrador ou dono na coleção admins
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 0. Coleção de Administradores (separada da pasta users)
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == adminId || isAdmin());
    }

    // 1. Coleção de Usuários
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 2. Subcontas Asaas dos Promotores
    match /subcontas_asaas/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 3. Coleção de Eventos
    match /events/{eventId} {
      // Qualquer um pode visualizar eventos publicados
      allow read: if true;
      // Usuários autenticados criam eventos
      allow create: if request.auth != null;
      // Dono do evento ou Admin da plataforma podem atualizar e excluir
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.promotorEmail == request.auth.token.email ||
        isAdmin()
      );
    }

    // 4. Inscrições nos Eventos
    match /inscricoes/{inscricaoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // 5. Certificados
    match /certificados/{certificadoId} {
      allow read: if true; // Permite validação pública de autenticidade
      allow write: if request.auth != null;
    }

    // 6. Trabalhos Científicos
    match /trabalhos/{trabalhoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 7. Métricas de Acessos e Visitas
    match /visitas_metricas/{visitaId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // 8. Códigos de Verificação Temporários (Cadastro e Segurança)
    match /codigos_verificacao/{codigoId} {
      allow read, write: if true;
    }
  }
}

